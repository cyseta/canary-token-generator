+func TestTriggersRecordAllMethodsAndAreIndistinguishable(t *testing.T) {
+	a := newApp(t)
+	c := a.create(t, map[string]any{"type": "webbug"})
+	for _, m := range []string{"GET", "HEAD", "POST", "PUT"} { // antes HEAD/PUT daban 405 y no se detectaban
