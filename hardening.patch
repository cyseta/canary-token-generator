+func TestAdminAuthRateLimitAndRedaction(t *testing.T) {
+	a := newApp(t)
+	c := a.create(t, map[string]any{"type": "webbug", "notify_channel": "webhook", "webhook_url": "https://hooks.example.com/SECRETPATH", "webhook_secret": "hmac-secret"})
