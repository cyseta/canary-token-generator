+const (
+	maxJSONBody   = 32 << 10 // peticiones JSON de la API
+	maxFPBody     = 16 << 10 // beacon de huella
+	maxPageLimit  = 100
+	maxPageOffset = 1_000_000
+	manageKeyHdr  = "X-Manage-Key"
