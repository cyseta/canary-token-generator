diff -ruN '--exclude=node_modules' '--exclude=dist' '--exclude=.git' '--exclude=pnpm-lock.yaml' a/backend/internal/netguard/netguard.go b/backend/internal/netguard/netguard.go
--- a/backend/internal/netguard/netguard.go	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/internal/netguard/netguard.go	2026-10-14 09:52:05.789028918 +0000
@@ -0,0 +1,167 @@
+// Package netguard protege contra SSRF en las peticiones salientes iniciadas por usuarios
+// (webhooks). La validacion se hace en el momento de conectar (DialContext) sobre la IP ya
+// resuelta, lo que neutraliza tambien DNS rebinding y redirecciones a redes internas.
+package netguard
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+var ErrBlockedAddress = errors.New("destination address is not allowed")
+
+type Resolver interface {
+	LookupNetIP(ctx context.Context, network, host string) ([]netip.Addr, error)
+}
+
+type Policy struct {
+	AllowPrivate bool          // permite destinos internos (solo para despliegues autoalojados de confianza)
+	AllowHTTP    bool          // permite http:// ademas de https://
+	Resolver     Resolver      // nil => net.DefaultResolver
+	Timeout      time.Duration // 0 => 10s
+}
+
+var blockedPrefixes = mustPrefixes(
+	"0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8", "169.254.0.0/16",
+	"172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24", "192.168.0.0/16", "198.18.0.0/15",
+	"198.51.100.0/24", "203.0.113.0/24", "224.0.0.0/4", "240.0.0.0/4",
+	"::/128", "::1/128", "fc00::/7", "fe80::/10", "ff00::/8", "2001:db8::/32",
+	"64:ff9b::/96", "2002::/16",
+)
+
+func mustPrefixes(ss ...string) []netip.Prefix {
+	out := make([]netip.Prefix, 0, len(ss))
+	for _, s := range ss {
+		out = append(out, netip.MustParsePrefix(s))
+	}
+	return out
+}
+
+// IsBlockedIP indica si la IP pertenece a un rango no enrutable publicamente.
+func IsBlockedIP(a netip.Addr) bool {
+	a = a.Unmap().WithZone("")
+	if !a.IsValid() || a.IsUnspecified() || a.IsLoopback() || a.IsPrivate() || a.IsLinkLocalUnicast() ||
+		a.IsLinkLocalMulticast() || a.IsMulticast() || a.IsInterfaceLocalMulticast() {
+		return true
+	}
+	for _, p := range blockedPrefixes {
+		if p.Contains(a) {
+			return true
+		}
+	}
+	return false
+}
+
+// ValidateURL valida sintacticamente una URL de webhook. No sustituye al control en el dial.
+func ValidateURL(raw string, p Policy) (*url.URL, error) {
+	raw = strings.TrimSpace(raw)
+	if raw == "" || len(raw) > 2048 {
+		return nil, errors.New("url is empty or too long")
+	}
+	u, err := url.Parse(raw)
+	if err != nil {
+		return nil, errors.New("url is malformed")
+	}
+	switch u.Scheme {
+	case "https":
+	case "http":
+		if !p.AllowHTTP {
+			return nil, errors.New("only https urls are allowed")
+		}
+	default:
+		return nil, errors.New("only https urls are allowed")
+	}
+	if u.User != nil {
+		return nil, errors.New("credentials in the url are not allowed")
+	}
+	host := u.Hostname()
+	if host == "" {
+		return nil, errors.New("url has no host")
+	}
+	if port := u.Port(); port != "" {
+		if n, err := strconv.Atoi(port); err != nil || n < 1 || n > 65535 {
+			return nil, errors.New("url has an invalid port")
+		}
+	}
+	if !p.AllowPrivate {
+		lh := strings.ToLower(strings.TrimSuffix(host, "."))
+		if lh == "localhost" || strings.HasSuffix(lh, ".localhost") || strings.HasSuffix(lh, ".local") ||
+			strings.HasSuffix(lh, ".internal") || strings.HasSuffix(lh, ".lan") || !strings.Contains(lh, ".") && net.ParseIP(lh) == nil {
+			return nil, errors.New("host is not allowed")
+		}
+		if a, err := netip.ParseAddr(host); err == nil && IsBlockedIP(a) {
+			return nil, errors.New("host is not allowed")
+		}
+	}
+	return u, nil
+}
+
+// NewClient devuelve un http.Client que nunca conecta a destinos bloqueados, no sigue
+// redirecciones y no usa proxies del entorno.
+func NewClient(p Policy) *http.Client {
+	timeout := p.Timeout
+	if timeout <= 0 {
+		timeout = 10 * time.Second
+	}
+	res := p.Resolver
+	if res == nil {
+		res = net.DefaultResolver
+	}
+	dialer := &net.Dialer{Timeout: 5 * time.Second}
+	tr := &http.Transport{
+		Proxy:                 nil,
+		ForceAttemptHTTP2:     true,
+		TLSHandshakeTimeout:   5 * time.Second,
+		ResponseHeaderTimeout: timeout,
+		MaxIdleConns:          16,
+		IdleConnTimeout:       30 * time.Second,
+		DialContext: func(ctx context.Context, network, addr string) (net.Conn, error) {
+			host, port, err := net.SplitHostPort(addr)
+			if err != nil {
+				return nil, err
+			}
+			var ips []netip.Addr
+			if a, err := netip.ParseAddr(host); err == nil {
+				ips = []netip.Addr{a}
+			} else if ips, err = res.LookupNetIP(ctx, "ip", host); err != nil || len(ips) == 0 {
+				return nil, fmt.Errorf("resolve %q: %w", host, errOrEmpty(err))
+			}
+			if !p.AllowPrivate {
+				for _, ip := range ips { // si CUALQUIER respuesta es interna, se rechaza todo
+					if IsBlockedIP(ip) {
+						return nil, ErrBlockedAddress
+					}
+				}
+			}
+			var lastErr error
+			for _, ip := range ips {
+				c, err := dialer.DialContext(ctx, network, net.JoinHostPort(ip.Unmap().String(), port))
+				if err == nil {
+					return c, nil
+				}
+				lastErr = err
+			}
+			return nil, lastErr
+		},
+	}
+	return &http.Client{
+		Transport:     tr,
+		Timeout:       timeout,
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+	}
+}
+
+func errOrEmpty(err error) error {
+	if err == nil {
+		return errors.New("no addresses")
+	}
+	return err
+}
diff -ruN '--exclude=node_modules' '--exclude=dist' '--exclude=.git' '--exclude=pnpm-lock.yaml' a/backend/internal/netguard/netguard_test.go b/backend/internal/netguard/netguard_test.go
--- a/backend/internal/netguard/netguard_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/internal/netguard/netguard_test.go	2026-10-14 09:52:05.790122004 +0000
@@ -0,0 +1,97 @@
+package netguard
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"strings"
+	"testing"
+)
+
+type fakeResolver map[string][]string
+
+func (f fakeResolver) LookupNetIP(_ context.Context, _, host string) ([]netip.Addr, error) {
+	var out []netip.Addr
+	for _, s := range f[host] {
+		out = append(out, netip.MustParseAddr(s))
+	}
+	return out, nil
+}
+
+func TestIsBlockedIP(t *testing.T) {
+	blocked := []string{"127.0.0.1", "10.1.2.3", "172.16.0.1", "192.168.1.1", "169.254.169.254", "100.64.0.1",
+		"0.0.0.0", "::1", "fe80::1", "fc00::1", "::ffff:127.0.0.1", "::ffff:169.254.169.254", "224.0.0.1", "64:ff9b::7f00:1", "2002:7f00:1::1"}
+	for _, s := range blocked {
+		if !IsBlockedIP(netip.MustParseAddr(s)) {
+			t.Errorf("%s deberia estar bloqueada", s)
+		}
+	}
+	for _, s := range []string{"8.8.8.8", "1.1.1.1", "93.184.216.34", "2606:4700:4700::1111"} {
+		if IsBlockedIP(netip.MustParseAddr(s)) {
+			t.Errorf("%s deberia estar permitida", s)
+		}
+	}
+}
+
+func TestValidateURL(t *testing.T) {
+	ok := []string{"https://hooks.example.com/abc", "https://example.com:8443/x?y=1"}
+	bad := []string{"", "http://example.com/x", "ftp://example.com", "https://user:pw@example.com/", "https:///nohost",
+		"https://localhost/x", "https://127.0.0.1/x", "https://169.254.169.254/latest/meta-data", "https://[::1]/x",
+		"https://intranet/x", "https://svc.internal/x", "https://example.com:99999/", "javascript:alert(1)",
+		"https://example.com/" + strings.Repeat("a", 3000)}
+	for _, s := range ok {
+		if _, err := ValidateURL(s, Policy{}); err != nil {
+			t.Errorf("%q deberia ser valida: %v", s, err)
+		}
+	}
+	for _, s := range bad {
+		if _, err := ValidateURL(s, Policy{}); err == nil {
+			t.Errorf("%q deberia ser rechazada", s)
+		}
+	}
+	if _, err := ValidateURL("http://10.0.0.5/hook", Policy{AllowPrivate: true, AllowHTTP: true}); err != nil {
+		t.Errorf("con AllowPrivate+AllowHTTP debe aceptarse: %v", err)
+	}
+}
+
+func TestClientBlocksLoopbackAndRebinding(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("internal-secret")) }))
+	defer srv.Close()
+
+	// 1) destino loopback literal
+	_, err := NewClient(Policy{AllowHTTP: true}).Get(srv.URL)
+	if !errors.Is(err, ErrBlockedAddress) {
+		t.Fatalf("esperaba ErrBlockedAddress, got %v", err)
+	}
+	// 2) hostname publico que RESUELVE a metadata cloud (rebinding / DNS malicioso)
+	res := fakeResolver{"evil.test": {"169.254.169.254"}, "mixed.test": {"8.8.8.8", "127.0.0.1"}}
+	for _, h := range []string{"evil.test", "mixed.test"} {
+		_, err = NewClient(Policy{Resolver: res}).Get("https://" + h + "/")
+		if !errors.Is(err, ErrBlockedAddress) {
+			t.Fatalf("%s: esperaba ErrBlockedAddress, got %v", h, err)
+		}
+	}
+	// 3) con AllowPrivate (autoalojado) si conecta
+	resp, err := NewClient(Policy{AllowPrivate: true, AllowHTTP: true}).Get(srv.URL)
+	if err != nil {
+		t.Fatalf("con AllowPrivate deberia conectar: %v", err)
+	}
+	resp.Body.Close()
+}
+
+func TestClientDoesNotFollowRedirects(t *testing.T) {
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { t.Error("la redireccion NO debe seguirse") }))
+	defer target.Close()
+	redir := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { http.Redirect(w, r, target.URL, http.StatusFound) }))
+	defer redir.Close()
+	resp, err := NewClient(Policy{AllowPrivate: true, AllowHTTP: true}).Get(redir.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusFound {
+		t.Fatalf("esperaba 302 sin seguir, got %d", resp.StatusCode)
+	}
+}
diff -ruN '--exclude=node_modules' '--exclude=dist' '--exclude=.git' '--exclude=pnpm-lock.yaml' a/backend/internal/notify/notify_test.go b/backend/internal/notify/notify_test.go
--- a/backend/internal/notify/notify_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/internal/notify/notify_test.go	2026-10-15 01:33:18.313286657 +0000
@@ -0,0 +1,185 @@
+package notify
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"canary-token-generator/backend/internal/netguard"
+	"canary-token-generator/backend/internal/notify/telegram"
+	"canary-token-generator/backend/internal/notify/webhook"
+)
+
+func privClient() *webhook.Client {
+	return webhook.NewClientWith(netguard.NewClient(netguard.Policy{AllowPrivate: true, AllowHTTP: true, Timeout: 3 * time.Second}))
+}
+
+// Regresion SSRF: la URL de webhook la aporta un usuario anonimo; no debe poder alcanzar la red interna.
+func TestWebhookSSRFBlockedByDefault(t *testing.T) {
+	var hits int32
+	internal := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { atomic.AddInt32(&hits, 1) }))
+	defer internal.Close()
+	d := NewDispatcherWith(1, 4, webhook.NewClient(false), telegram.NewClient(""))
+	d.Enqueue(NotificationJob{NotifyChannel: "webhook", WebhookURL: internal.URL, TokenID: "t"})
+	d.Shutdown()
+	if atomic.LoadInt32(&hits) != 0 {
+		t.Fatal("el webhook alcanzo un servicio interno (SSRF)")
+	}
+}
+
+func TestShutdownDrainsQueueAndEnqueueAfterIsSafe(t *testing.T) {
+	var got int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		time.Sleep(5 * time.Millisecond)
+		atomic.AddInt32(&got, 1)
+	}))
+	defer srv.Close()
+	d := NewDispatcherWith(2, 100, privClient(), telegram.NewClient(""))
+	for i := 0; i < 20; i++ {
+		d.Enqueue(NotificationJob{NotifyChannel: "webhook", WebhookURL: srv.URL + "/" + string(rune('a'+i)), TokenID: "t"})
+	}
+	d.Shutdown() // antes: cancel() inmediato descartaba las alertas pendientes
+	if n := atomic.LoadInt32(&got); n != 20 {
+		t.Fatalf("entregadas %d de 20: se perdieron alertas al apagar", n)
+	}
+	if d.Enqueue(NotificationJob{TokenID: "late"}) { // antes: panic "send on closed channel"
+		t.Fatal("Enqueue tras Shutdown debe devolver false")
+	}
+	d.Shutdown() // idempotente
+}
+
+func TestWebhookRetryPolicyAndSignature(t *testing.T) {
+	var calls int32
+	var sig, ts string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		atomic.AddInt32(&calls, 1)
+		sig, ts = r.Header.Get("X-Canary-Signature"), r.Header.Get("X-Canary-Timestamp")
+		b, _ := io.ReadAll(r.Body)
+		var p webhook.Payload
+		_ = json.Unmarshal(b, &p)
+		switch r.URL.Path {
+		case "/bad":
+			w.WriteHeader(400)
+		case "/flaky":
+			if atomic.LoadInt32(&calls) < 3 {
+				w.WriteHeader(503)
+			}
+		}
+	}))
+	defer srv.Close()
+	c := privClient()
+	c.SetBackoff(time.Millisecond)
+
+	atomic.StoreInt32(&calls, 0)
+	if err := c.Send(context.Background(), srv.URL+"/bad", "", webhook.Payload{}); err == nil || atomic.LoadInt32(&calls) != 1 {
+		t.Fatalf("4xx no debe reintentarse: calls=%d err=%v", calls, err)
+	}
+	atomic.StoreInt32(&calls, 0)
+	if err := c.Send(context.Background(), srv.URL+"/flaky", "s3cret", webhook.Payload{EventID: "e1"}); err != nil || atomic.LoadInt32(&calls) != 3 {
+		t.Fatalf("5xx debe reintentarse hasta exito: calls=%d err=%v", calls, err)
+	}
+	if !strings.HasPrefix(sig, "sha256=") || ts == "" {
+		t.Fatal("falta firma HMAC")
+	}
+}
+
+func TestWebhookErrorDoesNotLeakURLSecrets(t *testing.T) {
+	c := privClient()
+	c.SetBackoff(time.Millisecond)
+	err := c.Send(context.Background(), "http://127.0.0.1:1/services/T000/B000/SECRETSECRET", "", webhook.Payload{})
+	if err == nil || strings.Contains(err.Error(), "SECRETSECRET") {
