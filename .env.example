# Copia este fichero a .env y rellena los valores. NUNCA lo subas al repositorio.
# Genera secretos con:   openssl rand -hex 32

# ---------------------------------------------------------------- Obligatorias (compose.yml)
BASE_URL=https://canary.example.com        # URL publica (aparece en los senuelos y en los enlaces de gestion)
ADMIN_TOKEN=                               # >= 24 caracteres; no se admiten valores por defecto conocidos
POSTGRES_PASSWORD=                         # usa hex (openssl rand -hex 24): se inserta tal cual en la DSN
REDIS_PASSWORD=                            # idem

# ---------------------------------------------------------------- Opcionales
POSTGRES_USER=canary
POSTGRES_DB=canary_db
RETENTION_DAYS=90

# Cloudflare Turnstile (anti-abuso en la creacion de tokens). Se necesitan AMBAS claves.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Alertas por Telegram (bot compartido por todos los tokens)
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------- Red / seguridad
# Proxies cuyas cabeceras de reenvio se aceptan (CIDR/IP, separados por comas). Vacio = redes privadas
# (127/8, 10/8, 172.16/12, 192.168/16, fc00::/7), que cubre nginx dentro de Docker.
TRUSTED_PROXIES=
# De donde leer la IP real cuando el proxy es de confianza: x-forwarded-for | x-real-ip | cf-connecting-ip
CLIENT_IP_HEADER=x-forwarded-for

# Honeypot MySQL: host y puerto con los que el atacante alcanzara el 3306 (se incrustan en las credenciales senuelo).
# Vacio = hostname de BASE_URL. Con Cloudflare Tunnel el 3306 NO pasa por el tunel: pon aqui una IP/host publico.
PUBLIC_MYSQL_HOST=
PUBLIC_MYSQL_PORT=3306

# Solo autoalojado de confianza: permite webhooks a redes internas y http://. PROHIBIDO en produccion publica (SSRF).
ALLOW_PRIVATE_WEBHOOKS=false

# ---------------------------------------------------------------- Solo para el overlay de Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
