# syntax=docker/dockerfile:1
# La version de Go debe coincidir con la directiva `go` de backend/go.mod (antes 1.24 frente a go 1.26.0:
# las imagenes oficiales fijan GOTOOLCHAIN=local y la compilacion fallaba).
ARG GO_VERSION=1.26

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
RUN apk add --no-cache ca-certificates tzdata
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
# GOARCH sigue a la plataforma de destino (antes estaba fijado a amd64 y fallaba en arm64)
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags="-w -s" -o /out/canary-daemon ./cmd/canary

FROM alpine:3.22
RUN apk --no-cache add ca-certificates tzdata \
 && addgroup -S -g 10001 canary \
 && adduser -S -u 10001 -G canary -H -s /sbin/nologin canary \
 && mkdir -p /data && chown canary:canary /data
WORKDIR /data
COPY --from=builder /out/canary-daemon /usr/local/bin/canary-daemon
# El puerto 3306 NO es privilegiado (>1024): no hace falta ejecutar como root.
USER 10001:10001
EXPOSE 8080 3306
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/canary-daemon"]
