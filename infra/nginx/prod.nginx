user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 2048;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # El log usa $uri (sin query string) y NO registra el Referer: asi no se escriben secretos que viajen en URLs.
    log_format main '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent '
                    '"$http_user_agent" rt=$request_time';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 30;
    types_hash_max_size 2048;
    server_tokens off;

    # Limites frente a abuso / Slowloris
    client_max_body_size 64k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 15s;
    large_client_header_buffers 4 8k;

    limit_req_zone  $binary_remote_addr zone=trig:10m rate=50r/s;
    limit_req_zone  $binary_remote_addr zone=api:10m  rate=10r/s;
    limit_conn_zone $binary_remote_addr zone=perip:10m;
    limit_req_status 429;
    limit_conn_status 429;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript image/svg+xml;

    upstream backend_pool {
        server backend:8080;
        keepalive 32;
    }

    server {
        listen 80 default_server;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        # --- Cabeceras hacia el backend -------------------------------------------------------------
        # X-Forwarded-For se SOBRESCRIBE con la IP real de la conexion. Antes se usaba $proxy_add_x_forwarded_for,
        # que ANEXA a lo que envie el cliente: cualquiera podia falsificar la IP registrada (dato forense central).
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP "";   # nunca reenviar el valor del cliente
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 3s;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;

        # --- Operador: solo desde el propio host Docker (p.ej. tunel SSH). Ajusta los allow a tu red de gestion.
        location ^~ /admin/ {
            allow 127.0.0.1;
            allow ::1;
            allow 172.16.0.0/12;   # puente de Docker: peticiones originadas en el propio host
            deny all;
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://backend_pool;
        }

        # --- API de gestion ---------------------------------------------------------------------------
        location ^~ /api/ {
            limit_req zone=api burst=30 nodelay;
            limit_conn perip 20;
            proxy_pass http://backend_pool;
        }

        # --- Sensores publicos. El patron esta ANCLADO: antes "^/(api|t|r|f|k|...)/?" capturaba cualquier ruta que
        #     EMPEZARA por esas letras (/robots.txt, /favicon.ico, /test...) y la mandaba al backend.
        location ~ ^/(t|r|f|k)(/|$) {
            limit_req zone=trig burst=100 nodelay;
            limit_conn perip 40;
            proxy_pass http://backend_pool;
        }

        location = /healthz {
            proxy_pass http://backend_pool;
        }

        # --- Ficheros estaticos de la SPA ---------------------------------------------------------------
        location ^~ /assets/ {
            expires 1y;
            access_log off;
            include /etc/nginx/spa-security.conf;
        }

        location ~ /\.(?!well-known) {
            return 404;
        }

        location / {
            try_files $uri $uri/ /index.html;
            include /etc/nginx/spa-security.conf;
            add_header Cache-Control "no-cache" always;
        }
    }
}
